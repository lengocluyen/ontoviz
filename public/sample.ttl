@prefix ex: <https://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Person a owl:Class ;
  rdfs:label "Person" ;
  rdfs:comment "A human being (example definition annotation)." .

ex:Organization a owl:Class ;
  rdfs:label "Organization" ;
  rdfs:comment "An organized group, such as a company or institution." .

ex:Employee a owl:Class ;
  rdfs:subClassOf ex:Person ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ex:worksFor ;
    owl:someValuesFrom ex:Organization
  ] ;
  rdfs:label "Employee" ;
  rdfs:comment "A person who works for an organization." .

ex:worksFor a owl:ObjectProperty ;
  rdfs:domain ex:Person ;
  rdfs:range ex:Organization ;
  rdfs:label "works for" ;
  rdfs:comment "Relates a person to the organization they work for." .

ex:age a owl:DatatypeProperty ;
  rdfs:domain ex:Person ;
  rdfs:range xsd:integer ;
  rdfs:label "age" .

ex:alice a ex:Employee ;
  ex:worksFor ex:acme ;
  ex:age 29 ;
  rdfs:label "Alice" .

ex:acme a ex:Organization ;
  rdfs:label "ACME Inc." .

ex:knowledgeGraph a skos:Concept ;
  skos:prefLabel "Knowledge Graph" .
